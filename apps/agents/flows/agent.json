{
  "debug": {
    "log_request": false,
    "log_streaming": true,
    "log_override_file": true
  },
  "loop": {
    "max_turns": 50,
    "max_tool_calls": 10
  },
  "context": {
    "window_width_tokens": 100000,
    "compaction": {
      "compaction_trigger_ratio": 0.8,
      "compaction_target_ratio": 0.3,
      "keep_last_blocks": 10
    }
  },
  "tools": {
    "shell": {
      "allowed_paths": [
        "{{flow.dir}}",
        "{{runtime.venv}}"
      ],
      "allowlist_enabled": true,
      "allow_env_prefix": true,
      "allowed_commands": [
        "pwd",
        "ls",
        "find",
        "rg",
        "grep",
        "head",
        "tail",
        "wc",
        "nl",
        "cat",
        "git",
        "pytest",
        "ruff",
        "python",
        "python3",
        "skiller",
        "date"
      ]
    },
    "files": {
      "read": [
        "../../..",
        "~/.skiller/settings/"
      ],
      "write": [
        "../../.."
      ],
      "all": []
    }
  }
}
