{
  "providers": {
    "minimax": {
      "adapter": "openai",
      "enabled": true,
      "base_url": "https://api.minimax.io/v1",
      "api_key_env": "AGENT_MINIMAX_API_KEY",
      "timeout_seconds": 30,
      "temperature": 1,
      "top_p": 1,
      "parallel_tool_calls": true,
      "tool_choice": "auto",
      "options": {
        "reasoning_split": true
      },
      "models": [
        {
          "model": "MiniMax-M2.7",
          "context_window_tokens": 204800
        },
        {
          "model": "MiniMax-M2.5",
          "context_window_tokens": 204800
        },
        {
          "model": "MiniMax-M3",
          "context_window_tokens": 204800
        }
      ]
    },
    "moonshot": {
      "adapter": "openai",
      "enabled": true,
      "base_url": "https://api.moonshot.ai/v1",
      "api_key_env": "AGENT_MOONSHOT_API_KEY",
      "timeout_seconds": 30,
      "temperature": 1,
      "top_p": 0.95,
      "parallel_tool_calls": true,
      "tool_choice": "auto",
      "models": [
        {
          "model": "kimi-k3",
          "context_window_tokens": 256000
        },
        {
          "model": "kimi-k2.7-code",
          "context_window_tokens": 256000
