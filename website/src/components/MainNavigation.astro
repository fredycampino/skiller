<style>
  nav { display: flex; gap: 28px; align-items: center; }
  a { display: inline-flex; align-items: center; color: var(--muted, var(--sl-color-gray-2)); font-size: 0.9rem; text-decoration: none; }
  a:hover, a:focus-visible { color: var(--text, var(--sl-color-white)); }
</style>
